# Frontend Environment Configuration Example
PORT=3000
BUILD_PATH='./build'

# Branding
REACT_APP_APP_NAME="NSG CRM"
REACT_APP_COMPANY_NAME="Network Sales & Growth"
REACT_APP_BRAND_NAME="NSG"

# API & Base URLs
REACT_APP_API_URL=http://127.0.0.1:8000
REACT_APP_FRONTEND_URL=http://localhost:3000

# Google OAuth & Calendar Integration (Public Client ID ONLY)
REACT_APP_CALENDAR_CLIENT_ID=
REACT_APP_CALENDAR_REDIRECT_URL=http://localhost:3000/
REACT_APP_CALENDAR_SCOPES="https://www.googleapis.com/auth/calendar https://www.googleapis.com/auth/gmail.send https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/contacts.readonly"

# Stripe Payments (Public Publishable Key ONLY)
REACT_APP_STRIPE_PUBLISHABLE_KEY=
REACT_APP_STRIPE_BUY_BUTTON_ID=

# Firebase Cloud Messaging (Web Push Configuration)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_VAPID_KEY=

# SuprSend Notification Client (Public Key ONLY)
REACT_APP_SUPRSEND_PUBLIC_KEY=
REACT_APP_SUPRSEND_VAPID_KEY=
