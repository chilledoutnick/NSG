# ==============================================================================
# NSG CRM — Backend Environment Configuration Example
# Copy this file to .env and configure values appropriate for your environment.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL.
# ==============================================================================

# Application Branding & Metadata
APP_NAME=NSG CRM
COMPANY_NAME=Network Sales & Growth
BRAND_NAME=NSG
SUPPORT_EMAIL=support@nsgcrm.com
DEFAULT_FROM_EMAIL="NSG CRM <noreply@nsgcrm.com>"

# Core Django Settings
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4000

# Base URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
REDIRECT_DOMAIN=http://localhost:3000/

# Database Configuration (PostgreSQL)
# Either provide DATABASE_URL or individual DB_* variables
DATABASE_URL=
DB_ENGINE=django.db.backends.postgresql
DB_NAME=nsg_crm
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_SSL_MODE=prefer

# Celery & RabbitMQ / Redis Broker
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=django-db
REDIS_URL=

# Storage (AWS S3 or GCP Cloud Storage)
USE_S3=FALSE
GCP_STORAGE_BUCKET_NAME=
GOOGLE_APPLICATION_CREDENTIALS=

# Email / SMTP Configuration
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Stripe Payments
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth & Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Outlook OAuth Integration
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=

# LinkedIn OAuth & Data Integration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PROXYCURL_API_KEY=

# Twilio Communications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Mailchimp Marketing Integration
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
MAILCHIMP_DC=us10

# SuprSend Notification Infrastructure
SUPRSEND_WORKSPACE_KEY=
SUPRSEND_WORKSPACE_SECRET=
SUPRSEND_API_KEY=
SUPRSEND_SIGNING_KEY_PEM=
SUPRSEND_PUBLIC_KEY=

# Google Workspace / Firebase / Sheets / Gemini
FIREBASE_CREDENTIALS_PATH=
GOOGLE_SHEET_ID=
GEMINI_API_KEY=

# Security, Encryption & Tokens
FERNET_KEY=
JWT_SECRET=
SENDER_TOKEN=

# Digital Wallet Passes (Google Wallet / Apple Wallet)
WALLET_ISSUER_ID=
WALLET_CLASS_SUFFIX=nsg_business_card
WALLET_OBJECT_SUFFIX=nsg_business_obj

APPLE_PASS_PASSWORD=
APPLE_PASS_ORG_NAME="NSG Business Card"
APPLE_PASS_TYPE_IDENTIFIER=pass.crm.nsg.card
APPLE_TEAM_IDENTIFIER=
APPLE_CERTIFICATE_PATH=
APPLE_WWDR_PATH=
APPLE_PASS_AUTH_TOKEN=
